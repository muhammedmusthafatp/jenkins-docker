pipeline {
    agent any

    environment {
        IMAGE_NAME = "cicd-demo"
        CONTAINER_NAME = "cicd-container"
    }

    stages {

        stage('Clone') {
            steps {
                git branch: 'main',
                url: 'https://github.com/muhammedmusthafatp/jenkins-docker.git'
            }
        }

        stage('Build') {
            steps {
                sh 'docker build -t $IMAGE_NAME .'
            }
        }

        stage('Test') {
            steps {
                sh '''
                docker run -d --name test-container -p 5001:5000 $IMAGE_NAME
                sleep 10
                docker ps
                docker rm -f test-container
                '''
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                docker rm -f $CONTAINER_NAME || true

                docker run -d \
                --name $CONTAINER_NAME \
                -p 5000:5000 \
                $IMAGE_NAME
                sleep 120
                docker stop $CONTAINER_NAME
                docker rm $CONTAINER_NAME
                '''
            }
        }
    }
}
